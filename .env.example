# Optional AI settings for Diffguard
# Copy to .env locally if you want — never commit real keys.

# DIFFGUARD_AI_PROVIDER=ollama
# DIFFGUARD_AI_MODEL=llama3.2
# DIFFGUARD_AI_BASE_URL=http://127.0.0.1:11434

# OpenAI-compatible (OpenAI, Groq, LM Studio, etc.)
# DIFFGUARD_AI_PROVIDER=openai
# DIFFGUARD_AI_BASE_URL=https://api.openai.com/v1
# DIFFGUARD_AI_MODEL=gpt-4o-mini
# DIFFGUARD_AI_API_KEY=
# OPENAI_API_KEY=

# DIFFGUARD_AI_TIMEOUT_MS=120000
